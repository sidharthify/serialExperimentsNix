--- a/grub-core/kern/efi/init.c
+++ b/grub-core/kern/efi/init.c
@@ -111,8 +111,31 @@
    */
   if (grub_efi_get_secureboot () == GRUB_EFI_SECUREBOOT_MODE_ENABLED)
     {
-      grub_lockdown ();
-      grub_shim_lock_verifier_setup ();
+      struct grub_module_header *header;
+      int disable_shim_lock = 0;
+
+      /*
+       * If this image was built with --disable-shim-lock, the administrator
+       * has taken responsibility for the images GRUB loads (typically by
+       * signing grubx64.efi with their own key and enrolling it in db).
+       * Upstream still calls grub_lockdown() unconditionally, which registers
+       * a verifier that defers authentication to shim -- and with the
+       * shim_lock verifier disabled nothing answers, so every module, kernel
+       * and chainloaded image fails with "verification requested but nobody
+       * cares". Honour the flag for both.
+       */
+      FOR_MODULES (header)
+	if (header->type == OBJ_TYPE_DISABLE_SHIM_LOCK)
+	  {
+	    disable_shim_lock = 1;
+	    break;
+	  }
+
+      if (!disable_shim_lock)
+	{
+	  grub_lockdown ();
+	  grub_shim_lock_verifier_setup ();
+	}
     }
 
   grub_efi_system_table->boot_services->set_watchdog_timer (0, 0, 0, NULL);
